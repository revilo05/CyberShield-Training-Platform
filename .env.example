NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://cybershield:cybershield@localhost:5432/cybershield
DATABASE_POOL_MAX=8
# En Vercel: certificado CA de Supabase codificado como Base64 (una sola linea).
DATABASE_SSL_CA_BASE64=
# En desarrollo local: ruta al certificado CA; Node.js la lee al iniciar el proceso.
NODE_EXTRA_CA_CERTS=
REDIS_URL=redis://localhost:6379
AUTH0_DOMAIN=your-auth0-domain
AUTH0_AUDIENCE=cybershield-api
AUTH0_ISSUER=https://your-auth0-domain/
DEMO_MODE=true
AUTO_MIGRATE=true
WEB_ORIGIN=http://localhost:5173
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
AWS_REGION=us-east-1
SES_FROM_EMAIL=
SIMULATION_TOKEN_TTL_HOURS=72
CRON_SECRET=replace-with-at-least-32-random-characters
OUTBOX_BATCH_SIZE=10
CAMPAIGN_BATCH_SIZE=20
CAMPAIGN_RATE_LIMIT=20
OPENAI_API_KEY=
OPENAI_AUTHORING_MODEL=gpt-5.6-terra
WEBHOOK_ALLOWED_HOSTS=siem.example.com,hooks.example.com
VITE_API_URL=http://localhost:4000
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=cybershield-api
VITE_AUTH0_ORGANIZATION=
